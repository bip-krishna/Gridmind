# Optional. Defaults to .gridmind in the server working directory.
# Set an absolute directory to keep one database across server working directories.
# GRIDMIND_DATA_DIR=/absolute/path/to/gridmind-data

# Required if the server uses a different port or address.
# GRIDMIND_API_URL=http://127.0.0.1:3000

# Optional GitHub integration. Never required for local project memory.
# GITHUB_TOKEN=

# Optional browser sign-in for Apps & integrations. Register an OAuth app on GitHub,
# enable device flow, then set its public client ID. No client secret is needed.
# Without this, connect using a fine-grained token directly in the local UI.
# GITHUB_CLIENT_ID=
