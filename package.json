{
  "name": "gridmind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build:mcp": "esbuild src/mcp/cli.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/mcp/cli.mjs --banner:js='import { createRequire } from \"module\"; const require = createRequire(import.meta.url);'",
    "build": "next build && npm run build:mcp && npm run build:memory",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "test": "node tests/run-unit.mjs && npm run build:memory && node --test tests/project-memory.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node tests/run-integration.mjs",
    "build:memory": "node scripts/build-memory.mjs",
    "prepare": "npm run build:memory",
    "test:project": "node --test tests/project-memory.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@octokit/rest": "^21.1.1",
    "@xyflow/react": "^12.11.6",
    "better-sqlite3": "^13.0.3",
    "gsap": "^3.15.0",
    "jsonc-parser": "^3.3.1",
    "nanoid": "^5.1.16",
    "next": "15.5.25",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "smol-toml": "^1.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/oxide-darwin-arm64": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "gridmind": "bin/gridmind.mjs"
  },
  "files": [
    "bin",
    "cli",
    "dist/memory",
    "dist/mcp",
    "src",
    "scripts/build-memory.mjs",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json",
    "public"
  ]
}
